# Copy to .env.local. Every value is optional for local development.

# Postgres connection string. Use the provider's pooled endpoint in production.
# Leave unset to run on PGlite, an embedded Postgres stored in ./.data
DATABASE_URL=

# Secret used to sign session cookies. Required in production.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the app. Required in production, e.g. https://example.com
BETTER_AUTH_URL=http://localhost:3000
