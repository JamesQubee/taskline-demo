# Copy to .env.local. Every value is optional for local development.

# Postgres connection string. Use the provider's pooled endpoint in production.
# Leave unset to run on PGlite, an embedded Postgres stored in ./.data
DATABASE_URL=

# Secret used to sign session cookies. Required in production.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the app. On Vercel it is detected automatically, so set
# this only for a custom domain, e.g. https://example.com
BETTER_AUTH_URL=http://localhost:3000

# Shown in the footer of the public pages. Leave empty to hide them.
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_URL=
NEXT_PUBLIC_REPO_URL=
